{
  "name": "gamematch-fe",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "check": "npm test -- --watchAll=false --runInBand && npm run build",
    "prebuild": "node scripts/validate-env.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "testMatch": [
      "**/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "**/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "resolve-url-loader": "5.0.0",
    "serialize-javascript": "7.1.4",
    "@svgr/webpack": "8.1.0",
    "@tootallnate/once": "2.0.1",
    "sockjs": {
      "uuid": "11.1.1"
    },
    "webpack-dev-middleware": "7.4.5"
  }
}
